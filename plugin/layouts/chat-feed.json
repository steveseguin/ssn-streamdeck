{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "ninja.socialstream.chat-feed",
	"items": [
		{ "key": "platform", "type": "text", "rect": [8, 3, 58, 14], "alignment": "left", "color": "#5eead4", "font": { "size": 9, "weight": 800 }, "text-overflow": "ellipsis" },
		{ "key": "name", "type": "text", "rect": [70, 3, 122, 14], "alignment": "right", "color": "#e2e8f0", "font": { "size": 10, "weight": 700 }, "text-overflow": "ellipsis" },
		{ "key": "message", "type": "text", "rect": [8, 21, 184, 52], "alignment": "left", "color": "#ffffff", "font": { "size": 14, "weight": 600 }, "text-overflow": "ellipsis" },
		{ "key": "hint", "type": "text", "rect": [8, 79, 184, 14], "alignment": "center", "color": "#94a3b8", "font": { "size": 8, "weight": 600 }, "text-overflow": "ellipsis" }
	]
}
