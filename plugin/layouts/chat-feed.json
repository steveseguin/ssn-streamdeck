{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "ninja.socialstream.chat-feed",
	"items": [
		{ "key": "background", "type": "text", "rect": [0, 0, 200, 100], "background": "#0f172a", "zOrder": 0 },
		{ "key": "platform", "type": "text", "rect": [8, 3, 58, 14], "alignment": "left", "color": "#5eead4", "font": { "size": 10, "weight": 800 }, "text-overflow": "ellipsis", "zOrder": 1 },
		{ "key": "name", "type": "text", "rect": [70, 3, 122, 14], "alignment": "right", "color": "#e2e8f0", "font": { "size": 10, "weight": 700 }, "text-overflow": "ellipsis", "zOrder": 1 },
		{ "key": "message", "type": "text", "rect": [8, 21, 184, 43], "alignment": "left", "color": "#ffffff", "font": { "size": 14, "weight": 600 }, "text-overflow": "ellipsis", "zOrder": 1 },
		{ "key": "hint", "type": "text", "rect": [8, 67, 184, 14], "alignment": "center", "color": "#94a3b8", "font": { "size": 10, "weight": 600 }, "text-overflow": "ellipsis", "zOrder": 1 },
		{ "key": "touchHint", "type": "text", "rect": [8, 83, 184, 14], "alignment": "center", "color": "#94a3b8", "font": { "size": 10, "weight": 600 }, "text-overflow": "ellipsis", "zOrder": 1 }
	]
}
