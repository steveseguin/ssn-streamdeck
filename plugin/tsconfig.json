{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "ninja.socialstream.streamdeck.sdPlugin/bin",
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"]
